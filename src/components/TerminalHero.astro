---
import site from '../data/site.json';
import { getProjects, accents } from '../utils/projects';

const projects = await getProjects();
---

<section id="home" class="mx-auto grid w-full max-w-6xl grid-cols-1 items-center gap-12 px-5 py-14 md:grid-cols-[1.05fr_1fr] md:gap-14 md:pt-22 md:pb-26">
  <div>
    <p class="mb-4 font-mono text-sm text-vivid-sky-blue" data-reveal="fade">// ambystech open source</p>
    <h1 class="mb-5 font-mono text-[clamp(2.1rem,4.5vw,3.4rem)] font-extrabold leading-[1.12] tracking-tighter" data-reveal>
      Software we craft <span class="gradient-text">in&nbsp;the&nbsp;open.</span>
    </h1>
    <p class="mb-9 max-w-xl text-ink-dim" data-reveal style="--reveal-delay: .1s">
      Libraries and tools we build for ourselves at Ambystech, released for every
      developer to use, fork and improve. MIT licensed, maintained by the team
      that uses them every day.
    </p>
    <div class="flex flex-wrap gap-4" data-reveal style="--reveal-delay: .2s">
      <a
        class="inline-flex items-center rounded-full bg-fanatic-fuchsia px-6 py-2.5 font-mono text-[0.95rem] font-semibold text-white no-underline transition-all hover:bg-fanatic-fuchsia-dark hover:shadow-[0_10px_30px_-10px_var(--color-fanatic-fuchsia-light)]"
        href="#projects"
      >Browse projects</a>
      <a
        class="inline-flex items-center rounded-full border border-line px-6 py-2.5 font-mono text-[0.95rem] font-semibold text-ink-dim no-underline transition-colors hover:border-vivid-sky-blue hover:text-vivid-sky-blue"
        href={site.urls.githubOrg}
        rel="noopener"
      >github.com/ambystechcom</a>
    </div>
  </div>

  <div class="terminal-wrap relative" data-reveal="right" style="--reveal-delay: .15s">
    <div class="terminal relative z-[1] overflow-hidden rounded-[14px] border border-line bg-deep-raised shadow-[0_24px_60px_-24px_rgba(0,0,0,0.7)]" id="hero-terminal">
      <div class="flex items-center gap-2 border-b border-line bg-ink/3 px-4 py-3">
        <span class="size-3 rounded-full bg-fanatic-fuchsia" aria-hidden="true"></span>
        <span class="size-3 rounded-full bg-dark-orchid" aria-hidden="true"></span>
        <span class="size-3 rounded-full bg-vivid-sky-blue" aria-hidden="true"></span>
        <span class="ml-3 font-mono text-xs text-ink-faint">amby@ambystech: ~/oss</span>
      </div>
      <div class="overflow-x-auto px-6 py-6 font-mono text-[0.85rem] leading-[1.9]" role="img" aria-label="Terminal listing the Ambystech open source projects: elaris.ui, neo4j.repository and ambykit — three repositories, MIT licensed, pull requests welcome.">
        <p class="m-0 whitespace-nowrap"><span class="font-bold text-fanatic-fuchsia">$</span> <span class="t-cmd text-ink" data-cmd="amby ls --projects">amby ls --projects</span></p>
        <div class="t-out">
          <p class="t-line m-0"><span class="tracking-[0.08em] text-ink-faint">NAME</span><span class="tracking-[0.08em] text-ink-faint">LANG</span><span class="tracking-[0.08em] text-ink-faint">ABOUT</span></p>
          {projects.map((p) => (
            <p class="t-line m-0">
              <span class="font-bold" style={`color: ${accents[p.data.accent].color}`}>{p.data.name}</span>
              <span class="text-ink-dim">{p.data.language}</span>
              <span class="text-vivid-sky-blue">{p.data.terminalAbout}</span>
            </p>
          ))}
          <p class="t-line t-block m-0 whitespace-nowrap pt-1.5 text-ink-faint">{projects.length} repositories · MIT licensed · PRs welcome</p>
          <p class="t-line t-block m-0 whitespace-nowrap"><span class="font-bold text-fanatic-fuchsia">$</span> <span class="t-cursor" aria-hidden="true"></span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Ambient brand glow behind the terminal window */
  .terminal-wrap::before {
    content: "";
    position: absolute;
    inset: -12%;
    background:
      radial-gradient(45% 45% at 30% 30%, var(--color-fanatic-fuchsia-lighter), transparent 70%),
      radial-gradient(45% 45% at 75% 70%, rgba(0, 204, 255, 0.14), transparent 70%);
    filter: blur(18px);
    z-index: 0;
  }

  /* Session output: NAME / LANG / ABOUT columns */
  .t-line {
    display: grid;
    grid-template-columns: 10.5rem 6.5rem auto;
    column-gap: 1rem;
    min-width: max-content;
  }
  .t-line.t-block { display: block; }

  .t-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: text-bottom;
    background: var(--color-vivid-sky-blue);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* Typing choreography: JS adds .typing to replay the session on load */
  .terminal.typing .t-cmd { visibility: hidden; }
  .terminal.typing .t-cmd.t-live { visibility: visible; }
  .terminal.typing .t-out .t-line {
    opacity: 0;
    transition: opacity 0.12s steps(1);
  }
  .terminal.typing .t-out .t-line.t-shown { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .t-cursor { animation: none; }
  }
</style>

<script>
  // Replay the terminal session on load: type the command, then print
  // output lines one by one. Skipped for reduced-motion users — the full
  // session is already rendered in the markup.
  const term = document.getElementById('hero-terminal');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (term && !reduceMotion) {
    const cmdEl = term.querySelector<HTMLElement>('.t-cmd');
    const lines = term.querySelectorAll<HTMLElement>('.t-out .t-line');
    const cmd = cmdEl?.dataset.cmd ?? '';
    if (cmdEl && cmd) {
      term.classList.add('typing');
      cmdEl.textContent = '';
      cmdEl.classList.add('t-live');
      let i = 0;
      const typeNext = () => {
        if (i < cmd.length) {
          cmdEl.textContent = cmd.slice(0, ++i);
          setTimeout(typeNext, 34 + Math.floor((i * 7919) % 46));
        } else {
          let l = 0;
          const showNext = () => {
            if (l < lines.length) {
              lines[l++].classList.add('t-shown');
              setTimeout(showNext, l === lines.length ? 420 : 130);
            }
          };
          setTimeout(showNext, 260);
        }
      };
      setTimeout(typeNext, 500);
    }
  }
</script>
