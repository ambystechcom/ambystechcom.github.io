---
import site from '../data/site.json';
import logo from '../assets/ambystech-logo.svg';
import mobileLogo from '../assets/ambystech-mobile.png';
---

<header class="sticky top-0 z-[500] border-b border-line bg-deep/80 backdrop-blur-md">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-5">
    <a href="/" class="flex items-center gap-1 no-underline" aria-label="Ambystech Open Source — home">
      <img src={logo.src} alt="Ambystech" class="hidden h-9 w-auto sm:block" />
      <img src={mobileLogo.src} alt="Ambystech" class="h-9 w-auto sm:hidden" />
      <span class="font-mono text-[1.05rem] font-bold tracking-tight text-fanatic-fuchsia">/oss</span>
    </a>
    <nav aria-label="Main">
      <ul class="m-0 flex list-none items-center gap-7 p-0 max-sm:gap-4">
        <li class="max-sm:hidden">
          <a class="nav-link font-mono text-sm text-ink-dim no-underline transition-colors hover:text-ink" href="/#projects">Projects</a>
        </li>
        <li class="max-sm:hidden">
          <a class="nav-link font-mono text-sm text-ink-dim no-underline transition-colors hover:text-ink" href="/#ethos">Ethos</a>
        </li>
        <li>
          <a
            class="inline-flex items-center gap-2 rounded-full border border-fanatic-fuchsia px-4 py-1.5 font-mono text-sm font-semibold text-ink no-underline transition-colors hover:bg-fanatic-fuchsia hover:text-white"
            href={site.urls.githubOrg}
            rel="noopener"
          >
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
            </svg>
            GitHub
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
