---
import Icon from '@ambystech/ui/components/Icon.astro';
import InstallCommand from './InstallCommand.astro';
import { packageUrl, langClass, type ProjectEntry } from '../utils/projects';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;
const detailUrl = `/projects/${project.id}/`;
---

<article
  class="card-hover flex h-full min-w-0 flex-col rounded-3xl border border-line-200 bg-white p-[22px] shadow-(--shadow-card) sm:p-7"
  data-lang={data.language}
>
  <div class="flex items-start gap-4">
    <span aria-hidden="true" class={`tile-${data.tile} grid size-[52px] flex-none place-items-center rounded-2xl text-white shadow-[0_10px_22px_rgba(79,104,211,.18)]`}>
      <Icon name={data.icon} size={22} />
    </span>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="mono m-0 text-xl font-bold tracking-[-.02em] text-ink-950">
          <a href={detailUrl} class="text-inherit no-underline hover:text-fuchsia-text">{data.name}</a>
        </h3>
        <span class={`lang-pill ${langClass(data)}`}><i aria-hidden="true"></i>{data.language}</span>
      </div>
      <p class="mt-1.5 text-xs font-semibold text-muted-500 [overflow-wrap:anywhere]">{data.packageName}</p>
    </div>
    <span class="flex-none rounded-full border border-line-200 px-2.5 py-1 text-[10px] font-extrabold tracking-[.04em] text-slate-600">{data.license}</span>
  </div>

  <p class="mt-[18px] text-[13.5px] leading-[1.75] text-slate-600">{data.description}</p>

  <ul class="m-0 mt-4 flex list-none flex-wrap gap-1.5 p-0" aria-label="Topics">
    {data.topics.map((topic) => <li class="tag !px-2.5 !py-[5px] !text-[10px]">{topic}</li>)}
  </ul>

  <div class="mt-5"><InstallCommand command={data.install} label={data.name} /></div>

  <div class="mt-auto flex flex-wrap items-center gap-x-[18px] gap-y-1.5 border-t border-line-100 pt-5 [margin-top:auto]">
    <a href={data.url} rel="noopener" class="inline-flex min-h-11 items-center gap-[7px] text-[12.5px] font-bold text-navy-800 no-underline hover:text-ink-950">
      <Icon name="github" size={14} />GitHub
    </a>
    <a href={packageUrl(data)} rel="noopener" class="inline-flex min-h-11 items-center gap-[7px] text-[12.5px] font-bold text-navy-800 no-underline hover:text-ink-950">
      <Icon name="cube" size={13} />{data.registry}
    </a>
    <a href={detailUrl} class="ml-auto inline-flex min-h-11 items-center gap-[7px] text-[12.5px] font-bold text-fuchsia-text no-underline hover:text-ink-950">
      Project details<Icon name="arrowRight" size={11} />
    </a>
  </div>
</article>
