---
import SiteFooter from '@ambystech/ui/components/SiteFooter.astro';
import Icon from '@ambystech/ui/components/Icon.astro';
import site from '../data/site.json';
import { getProjects } from '../utils/projects';

const projects = await getProjects();
const social = [
  { name: 'GitHub', icon: 'github', label: 'Ambystech on GitHub' },
  { name: 'X', icon: 'xTwitter', label: 'Ambystech on X' },
  { name: 'LinkedIn', icon: 'linkedin', label: 'Ambystech on LinkedIn' },
] as const;

// Columns mirror the other open-source sites so the family reads as one.
const columns = [
  {
    title: 'Projects',
    items: [
      ...projects.map((p) => ({ label: p.data.name, href: `/projects/${p.id}/` })),
      { label: 'All repositories →', href: site.urls.githubOrg },
    ],
  },
  {
    title: 'Open source',
    items: [
      { label: 'ambystech.io', href: '/' },
      { label: 'AmbyKit docs', href: site.urls.ambykit },
      { label: 'Engineering talks', href: site.urls.decks },
      { label: 'Contributing', href: site.urls.githubOrg },
    ],
  },
  {
    title: 'Ambystech',
    items: [
      { label: 'ambystech.com', href: site.urls.corporate },
      { label: 'Insights', href: site.urls.blog },
      { label: 'Careers', href: site.urls.jobs },
      { label: 'Contact', href: `mailto:${site.email}` },
    ],
  },
];
---

<SiteFooter
  homeLabel="Ambystech Open Source home"
  tagline="Libraries and tools we build for our own work, released under MIT for yours."
  columns={columns}
  copyright={`© ${new Date().getFullYear()} ${site.company} · ${site.legalName}`}
  notice="All projects MIT licensed unless noted otherwise."
>
  <Fragment slot="brand-extra">
    <a href={`mailto:${site.email}`} class="mt-3 inline-flex min-h-8 items-center gap-[9px] text-[12.5px] font-semibold text-navy-800 no-underline hover:text-ink-950">
      <Icon name="envelope" size={13} /><span>{site.email}</span>
    </a>
    <div class="mt-2.5 flex gap-2">
      {social.map((s) => (
        <a href={site.socialLinks.find((l) => l.name === s.name)?.url} rel="noopener" aria-label={s.label} class="grid size-10 place-items-center rounded-xl border border-line-200 text-navy-800 hover:border-line-300 hover:text-ink-950">
          <Icon name={s.icon} size={15} />
        </a>
      ))}
    </div>
  </Fragment>
</SiteFooter>
