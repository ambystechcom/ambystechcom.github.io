---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import Icon from '@ambystech/ui/components/Icon.astro';
import { getProjects, packageUrl, langClass } from '../../utils/projects';
import type { ProjectEntry } from '../../utils/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const glance = [
  ['Language', data.language],
  ['Registry', data.registry],
  ['Package', data.packageName],
  ['License', data.license],
  ['Repository', `ambystechcom/${data.repo}`],
];

const canonical = new URL(`/projects/${project.id}/`, Astro.site);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: data.repo,
    alternateName: data.name,
    description: data.description,
    url: canonical.toString(),
    codeRepository: data.url,
    programmingLanguage: data.language,
    license: 'https://opensource.org/licenses/MIT',
    keywords: data.topics.join(', '),
    author: { '@id': `${(Astro.site ?? new URL('https://ambystech.io')).origin}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Projects', item: new URL('/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: data.name, item: canonical.toString() },
    ],
  },
];
---

<Layout
  title={`${data.name} — ${data.tagline} | Ambystech Open Source`}
  description={data.description}
  image={`/og/${project.id}.png`}
  keywords={[data.name, data.repo, data.packageName, data.language.toLowerCase(), ...data.topics]}
  schema={schema}
>
  <Header active={0} />
  <main id="main">
    <section aria-labelledby="p-title" class="relative overflow-hidden border-b border-line-100 bg-[linear-gradient(135deg,#fbfbff,#f5f7ff_55%,#fff7fc)] py-10 sm:py-[72px]">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_50%_60%_at_8%_10%,rgba(242,12,149,.07),transparent_70%),radial-gradient(ellipse_50%_60%_at_92%_40%,rgba(75,114,255,.10),transparent_70%)]"></div>
      <div class="container-site relative grid items-start gap-10 min-[961px]:grid-cols-[1.25fr_.75fr] min-[961px]:gap-14">
        <div class="min-w-0" data-reveal>
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs text-muted-500">
            <a href="/" class="text-muted-500 no-underline hover:text-ink-950">Open source</a><span aria-hidden="true">/</span>
            <a href="/#projects" class="text-muted-500 no-underline hover:text-ink-950">Projects</a><span aria-hidden="true">/</span>
            <span aria-current="page" class="mono font-bold text-navy-900">{data.name}</span>
          </nav>

          <div class="mt-[26px] flex flex-wrap items-center gap-3.5">
            <span aria-hidden="true" class={`tile-${data.tile} grid size-14 place-items-center rounded-2xl text-white shadow-[0_10px_22px_rgba(79,104,211,.18)]`}><Icon name={data.icon} size={24} /></span>
            <span class="mono text-[22px] font-bold tracking-[-.02em] text-ink-950">{data.name}</span>
            <span class={`lang-pill ${langClass(data)}`}><i aria-hidden="true"></i>{data.language}</span>
            <span class="rounded-full border border-line-300 bg-white px-2.5 py-1 text-[10px] font-extrabold tracking-[.04em] text-slate-600">{data.license}</span>
          </div>

          <h1 id="p-title" class="mt-5 max-w-[16ch] text-[clamp(38px,5vw,64px)] font-[780] leading-[.98] tracking-[-.05em] text-ink-950">{data.tagline}</h1>
          <p class="mt-[18px] max-w-[58ch] text-base leading-[1.8] text-muted-500">{data.description}</p>

          <div class="mt-7 max-w-[520px]"><InstallCommand command={data.install} label={data.name} /></div>

          <div class="mt-[18px] flex flex-wrap gap-3">
            <a href={data.url} rel="noopener" class="btn-cta h-12 px-6 text-[13px] font-extrabold"><Icon name="github" size={15} />View on GitHub</a>
            <a href={packageUrl(data)} rel="noopener" class="btn-outline !h-12 !px-[22px] !text-[13px] !font-bold !text-navy-900"><Icon name="cube" size={14} />{data.registry}</a>
          </div>
        </div>

        <aside aria-labelledby="glance" class="min-w-0 overflow-hidden rounded-[28px] border border-line-200/90 bg-white/80 shadow-(--shadow-glass) backdrop-blur-[20px]" data-reveal style="--reveal-delay: .1s">
          <p id="glance" class="section-eyebrow m-0 px-[22px] pt-5 text-accent-blue">At a glance</p>
          <dl class="m-0 mt-2.5 px-[22px]">
            {glance.map(([k, v]) => (
              <div class="grid grid-cols-[112px_minmax(0,1fr)] gap-3 border-b border-line-100 py-[13px]">
                <dt class="text-xs font-semibold text-muted-500">{k}</dt>
                <dd class="m-0 min-w-0 text-[13px] font-bold text-navy-900 [overflow-wrap:anywhere]">{v}</dd>
              </div>
            ))}
          </dl>
          <div class="px-[22px] pb-5 pt-4">
            <p class="m-0 mb-2 text-xs font-semibold text-muted-500">Topics</p>
            <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0">
              {data.topics.map((t) => <li class="tag !px-2.5 !py-[5px] !text-[10px]">{t}</li>)}
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <div class="container-site section-pad">
      <article class="prose-oss max-w-[820px]" data-reveal>
        <Content />
      </article>
    </div>
  </main>
  <Footer />
</Layout>
