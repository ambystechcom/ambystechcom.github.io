---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import InstallCommand from '../../components/InstallCommand.astro';
import { getProjects, packageUrl, accents, type ProjectEntry } from '../../utils/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const accent = accents[data.accent];

const canonical = new URL(`/projects/${project.id}/`, Astro.site);
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareSourceCode',
    name: data.repo,
    alternateName: data.name,
    description: data.description,
    url: canonical.toString(),
    codeRepository: data.url,
    programmingLanguage: data.language,
    license: 'https://opensource.org/licenses/MIT',
    keywords: data.topics.join(', '),
    author: { '@id': `${(Astro.site ?? new URL('https://ambystech.io')).origin}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Projects',
        item: new URL('/', Astro.site).toString(),
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: data.name,
        item: canonical.toString(),
      },
    ],
  },
];
---

<Layout
  title={`${data.name} — ${data.tagline} | Ambystech Open Source`}
  description={data.description}
  image={`/og/${project.id}.png`}
  keywords={[data.name, data.repo, data.packageName, data.language.toLowerCase(), ...data.topics]}
  schema={schema}
>
  <Nav />
  <main id="main" style={`--accent: ${accent.color}; --accent-soft: ${accent.soft};`}>
    <header class="mx-auto w-full max-w-[50rem] px-5 pb-4 pt-14">
      <p class="mb-9 font-mono text-sm text-ink-dim" data-reveal="fade">
        <span class="font-bold text-fanatic-fuchsia">$</span> cd
        <a href="/#projects" class="text-vivid-sky-blue no-underline hover:underline">~/oss</a>/<span class="text-(--accent)">{project.id}</span>
      </p>
      <p class="mb-1.5 font-mono text-[0.8rem] text-ink-faint" data-reveal>ambystechcom/{data.repo}</p>
      <h1 class="mb-2 font-mono text-[clamp(2.1rem,4.5vw,3rem)] font-extrabold tracking-tighter text-(--accent)" data-reveal>{data.name}</h1>
      <p class="mb-3 text-[1.15rem] font-semibold" data-reveal style="--reveal-delay: .08s">{data.tagline}</p>
      <p class="mb-6 max-w-2xl text-ink-dim" data-reveal style="--reveal-delay: .12s">{data.description}</p>
      <div class="mb-7 flex flex-wrap gap-2" data-reveal style="--reveal-delay: .16s">
        <span class="rounded-full border border-(--accent)/45 px-3 py-0.5 font-mono text-xs font-semibold text-(--accent)">{data.license}</span>
        <span class="rounded-full border border-line px-3 py-0.5 font-mono text-xs text-ink-dim">{data.language}</span>
        {data.topics.map((topic) => (
          <span class="rounded-full border border-line px-3 py-0.5 font-mono text-xs text-ink-faint">{topic}</span>
        ))}
      </div>
      <div class="flex flex-wrap items-center gap-4" data-reveal style="--reveal-delay: .2s">
        <div class="max-w-md flex-[1_1_18rem]">
          <InstallCommand command={data.install} label={data.name} />
        </div>
        <a
          class="inline-flex items-center gap-2 rounded-full border border-(--accent) px-5 py-2 font-mono text-sm font-semibold text-ink no-underline transition-colors hover:bg-(--accent) hover:text-white"
          href={data.url}
          rel="noopener"
        >
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
          </svg>
          View on GitHub
        </a>
        <a
          class="font-mono text-[0.8rem] text-ink-dim no-underline hover:text-(--accent) hover:underline"
          href={packageUrl(data)}
          rel="noopener"
        >{data.registry}: {data.packageName}</a>
      </div>
    </header>

    <article class="prose mx-auto w-full px-5" data-reveal>
      <Content />
    </article>
  </main>
  <Footer />
</Layout>
